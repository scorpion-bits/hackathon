# Copie para .env (não commitar!). Sem chave, a IA funciona em modo offline (responde com dados reais, sem LLM).
# IA gratuita (Groq): crie a chave em https://console.groq.com → API Keys. Passo a passo: docs/implementacao/M5-ia.md
AGROBITS_LLM_BASE_URL=https://api.groq.com/openai/v1
AGROBITS_LLM_API_KEY=
AGROBITS_LLM_MODEL=openai/gpt-oss-120b
# Alternativa (Gemini): BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  MODEL=gemini-2.5-flash
# Os nomes antigos AGROIA_LLM_BASE_URL / _API_KEY / _MODEL continuam funcionando.
# AGROIA_WEATHER_FIXTURE=1   # só desenvolvimento sem internet (clima SIMULADO, rotulado)
